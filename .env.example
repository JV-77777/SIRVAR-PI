# Copiar a .env solo si todavía no existe uno.
CAMERA_DEVICE=/dev/video0
CAMERA_WIDTH=640
CAMERA_HEIGHT=360
CAMERA_FPS=30
# Máximo de publicación: la cadencia real puede ser menor.
PREVIEW_FPS=15
JPEG_QUALITY=75
HOST=0.0.0.0
PORT=8080

# Detector: comienza pausado en cada arranque. No modificar .env para activarlo.
# Intervalo mínimo entre inicios de análisis; no es la frecuencia del video.
DETECTION_INTERVAL=1.0
DETECTION_CONFIDENCE=0.65
DETECTION_COOLDOWN=10

# Ajustes 0.5. Los porcentajes guardados desde la interfaz tienen prioridad.
DETECTION_REST=0.6
FILTER_PERSON_FRACTION=0.45
FILTER_ZONE_FRACTION=0.12
FILTER_MOTION_FRACTION=0.03

# Correo manual 0.8. Opcional: completar en .env y reiniciar la aplicación.
# No se envían correos automáticamente. Se requiere revisar y confirmar desde la UI.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
